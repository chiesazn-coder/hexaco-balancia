// CATATAN: File ini HANYA berisi tiga match block baru untuk asesmen
// (hexacoCandidates, hexacoSessions & kraepelinSessions), sesuai hasil audit FIX 3.
//
// Project Firebase ini (balancia-attendance-mobile) dipakai bersama app lain.
// JANGAN replace rules yang sudah ada di Firebase Console — salin tiga
// match block di bawah ini ke dalam `service cloud.firestore { match /databases/{database}/documents { ... } }`
// yang sudah ada di Console, di samping match block untuk collection lain
// (mis. attendance/users), lalu deploy dari Console atau via:
//   firebase deploy --only firestore:rules
//
// Belum dideploy secara otomatis oleh Claude — perlu ditempel manual ke
// Firebase Console > Firestore Database > Rules, karena ini mengubah
// akses data produksi yang dipakai bersama app lain.

match /hexacoCandidates/{uid} {
  // Kandidat hanya bisa baca & tulis data diri sendiri
  allow read: if request.auth != null && request.auth.uid == uid;
  // Hanya boleh create atau update field selain hasSubmitted
  // hasSubmitted hanya boleh diubah dari false -> true, tidak bisa balik
  allow create: if request.auth != null && request.auth.uid == uid;
  allow update: if request.auth != null
    && request.auth.uid == uid
    && !(request.resource.data.hasSubmitted == false
         && resource.data.hasSubmitted == true);
}

match /hexacoSessions/{sessionId} {
  // Kandidat hanya bisa create sekali, tidak bisa update/delete
  allow create: if request.auth != null
    && request.resource.data.candidateId == request.auth.uid;
  allow read: if request.auth != null
    && (request.auth.uid == resource.data.candidateId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
           in ["admin", "hcga_manager", "hcga_admin"]);
  allow update, delete: if false;
}

// Tes Kraepelin. Dokumen berkunci uid kandidat; test-hub dan halaman tes membaca
// kraepelinSessions/{uid} untuk status tes. Tidak ada rule update/delete (default: ditolak).
match /kraepelinSessions/{uid} {
  // Kandidat hanya bisa membuat dokumennya sendiri, satu kali.
  // Note: HEXACO completion is not enforced here — enforced in page
  // guard instead. Server-side enforcement requires Cloud Functions.
  allow create: if request.auth != null
    && request.auth.uid == uid
    && !exists(/databases/$(database)/documents/kraepelinSessions/$(uid));
  // Berdasarkan id dokumen (bukan resource.data): membaca dokumen yang belum ada tidak error
  // di rule, jadi test-hub bisa membedakan "belum ada" dari "ditolak".
  allow read: if request.auth != null && request.auth.uid == uid;
}
