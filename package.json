{
  "name": "hexaco-inventory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-hexaco \"npm test\"",
    "audit:assessments": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/audit-assessments.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
